# Environment Configuration for Australian Financial Family Assistant

# 1. API Backend Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key
SQLITE_DB_PATH=../../data/app.db

# 2. Pinecone Vector Database
# Obtain a free API key from https://www.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=australian-financial-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# 3. Embeddings & LLM Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LLM_PROVIDER=groq
# If using Groq Cloud LLM (get free key at https://console.groq.com):
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# If using Local Ollama (run `ollama serve` & `ollama pull llama3.2`):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 4. Local Voice Configuration (STT & TTS)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
TTS_ENGINE=local

# 5. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Aurora Spatial Financial RAG"
NEXT_PUBLIC_DEFAULT_CURRENCY=AUD
