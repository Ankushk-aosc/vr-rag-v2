# Copy to .env and fill in. Read by docker compose and by the API when run directly (apps/api/app/config.py).
# Never commit .env.

# --- Required ---
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# development | test | production. Outside development/test the API refuses weak secrets and
# superuser database roles, and never seeds the demo admin.
ENVIRONMENT=development

# --- docker compose: PostgreSQL ---
# Use URL-safe characters (letters, digits, - and _): APP_DB_PASSWORD is placed in DATABASE_URL.
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=vrrag_app
APP_DB_PASSWORD=
# Password for the schema-owner role that runs migrations (docker-compose); required, no default
MIGRATION_DB_PASSWORD=
APP_DB_NAME=vr_rag
# Running the API outside docker? Leave DATABASE_URL unset for SQLite (apps/api/data/app.db), or point it at
# the compose database: postgresql+psycopg://vrrag_app:<APP_DB_PASSWORD>@127.0.0.1:5432/vr_rag
# DATABASE_URL=

# --- Privacy (see README) ---
# local: documents, vectors, prompts and audio stay in this deployment. cloud: opt in to Pinecone + Groq.
PRIVACY_MODE=local
LLM_PROVIDER=local
# OpenAI-compatible local LLM server, when the API runs directly on this machine
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
# The same server as seen from the docker compose API container (default: the host machine)
# DOCKER_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Only used with PRIVACY_MODE=cloud ---
PINECONE_API_KEY=
GROQ_API_KEY=

# --- Web client (compiled into the browser bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Development demo admin (seeded only when ENVIRONMENT is development/test) ---
# Leave empty to skip seeding. Never set outside development.
DEMO_ADMIN_PASSWORD=
